# Copy to .env and edit. No quotes around values.
# Only SERVER_HOST is required. Everything else has a sensible default.

# Shown in the page header
SERVER_NAME=Home NTP server

# --- The NTP server to monitor ---------------------------------------------
# IP or hostname of the server, as seen from the dashboard container.
# Works with chrony, ntpd (pfSense, OPNsense, Linux) or any other NTP server.
SERVER_HOST=192.168.1.10

# auto   = try chrony, then ntpd, then fall back to the plain NTP port (default)
# chrony | ntpd | probe (probe = only measure the NTP port, never query the server's daemon)
SERVER_TYPE=auto
# chrony command port (UDP). Only used for chrony.
CHRONY_PORT=323
# NTP port the dashboard measures latency against. For ntpd this is also where its status is read.
NTP_PORT=123
# Seconds between server polls
POLL_INTERVAL=5

# --- GPS receiver (optional) -----------------------------------------------
# auto = show GPS panels only if gpsd answers. true = always, false = never.
GPSD_ENABLED=auto
#GPSD_HOST=192.168.1.10
GPSD_PORT=2947

# --- Public servers used as an independent cross-check ----------------------
# Comma separated. Leave empty (REFERENCE_SERVERS=) to turn this off.
REFERENCE_SERVERS=time.cloudflare.com,time.google.com
# Seconds between checks (minimum 32; please be gentle with public servers)
REFERENCE_INTERVAL=64

# --- Web page ---------------------------------------------------------------
# Host port for docker-compose.yml. (With docker-compose.host.yml set PORT instead.)
HOST_PORT=8080
# Optional password for the whole page
#BASIC_AUTH_USER=admin
#BASIC_AUTH_PASS=change-me

# --- Privacy ----------------------------------------------------------------
# Decimal places kept for the antenna position: 2 is about 1 km, 6 is exact.
COORD_DECIMALS=2
# true removes the position and the map points completely (the sky view stays)
HIDE_POSITION=false

# --- History ----------------------------------------------------------------
HISTORY_DAYS=7
SAMPLE_INTERVAL=10
NTP_INTERVAL=5

# --- Map tiles (defaults to OpenStreetMap) ----------------------------------
#MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
